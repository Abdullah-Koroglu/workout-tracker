# GitHub webhook listener configuration
WEBHOOK_PORT=9010
WEBHOOK_PATH=/github/webhook
GITHUB_WEBHOOK_SECRET=replace-with-long-random-secret
GITHUB_REPOSITORY=owner/repository

# Deploy runtime configuration
DOCKER_ENV_FILE=.env.docker.prod
DEPLOY_BRANCH=main
DEPLOY_REMOTE=origin
DOCKER_IMAGE_REPO=fitcoach

# Health checks
STAGING_HEALTH_URL=http://127.0.0.1:3002/
PRODUCTION_HEALTH_URL=http://127.0.0.1:3000/
DEPLOY_HEALTH_RETRIES=20
DEPLOY_HEALTH_DELAY_MS=3000
DEPLOY_HEALTH_TIMEOUT_MS=5000

# Optional: set to true if staging must be re-seeded on each deploy
STAGING_AUTO_SEED=false
