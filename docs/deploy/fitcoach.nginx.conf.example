map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 80;
  server_name fitcoach.akoroglu.com.tr;
  return 301 https://$host$request_uri;
}

server {
  listen 80;
  server_name staging.fitcoach.akoroglu.com.tr;
  return 301 https://$host$request_uri;
}

server {
  listen 80;
  server_name studio.fitcoach.akoroglu.com.tr;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name fitcoach.akoroglu.com.tr;

  ssl_certificate /etc/letsencrypt/live/fitcoach.akoroglu.com.tr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/fitcoach.akoroglu.com.tr/privkey.pem;

  client_max_body_size 25m;

  location /ws {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 443 ssl http2;
  server_name staging.fitcoach.akoroglu.com.tr;

  ssl_certificate /etc/letsencrypt/live/staging.fitcoach.akoroglu.com.tr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/staging.fitcoach.akoroglu.com.tr/privkey.pem;

  client_max_body_size 25m;

  location /ws {
    proxy_pass http://127.0.0.1:3003;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    proxy_pass http://127.0.0.1:3002;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 443 ssl http2;
  server_name studio.fitcoach.akoroglu.com.tr;

  ssl_certificate /etc/letsencrypt/live/studio.fitcoach.akoroglu.com.tr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/studio.fitcoach.akoroglu.com.tr/privkey.pem;

  location / {
    proxy_pass http://127.0.0.1:5555;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
